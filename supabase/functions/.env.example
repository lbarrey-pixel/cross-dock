# Segredos das edge functions. SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o Supabase injeta sozinho.
# Local: supabase functions serve --env-file supabase/functions/.env
# Produção: supabase secrets set --env-file supabase/functions/.env

# Origens que podem chamar as functions pelo navegador (separadas por vírgula).
ALLOWED_ORIGINS=http://localhost:5173
# Segredo do agendador (pg_cron). O mesmo valor vai para o Vault como 'cron_secret'.
CRON_SECRET=troque-por-um-valor-aleatorio

# ERP de origem dos pedidos (API REST v3 com OAuth2).
ERP_API_URL=https://erp.example.com/api/v3
ERP_AUTH_URL=https://auth.example.com/oauth2

# API da transportadora (cotação e rastreio).
TRANSPORTADORA_API_URL=https://api.transportadora.example.com

# Opcional: desempate do casamento por LLM (qualquer API de chat). As mesmas chaves podem ser
# gravadas pela tela de Configurações; as credenciais do banco têm prioridade sobre estas variáveis.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
